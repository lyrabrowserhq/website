---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Newer', nextText = 'Older' } = Astro.props;
---

{(prevUrl || nextUrl) && (
  <nav class="container flex" aria-label="Pagination">
    <div class="flex flex-row mx-auto container justify-between">
      <Button
        variant="tertiary"
        class={`md:px-3 px-3 mr-2 ${!prevUrl ? 'invisible' : ''}`}
        href={prevUrl}
        aria-hidden={!prevUrl ? 'true' : undefined}
        tabindex={!prevUrl ? -1 : undefined}
      >
        <Icon name="tabler:chevron-left" class="w-6 h-6" aria-hidden="true" />
        <p class="ml-2">{prevText}</p>
      </Button>

      <Button
        variant="tertiary"
        class={`md:px-3 px-3 ${!nextUrl ? 'invisible' : ''}`}
        href={nextUrl}
        aria-hidden={!nextUrl ? 'true' : undefined}
        tabindex={!nextUrl ? -1 : undefined}
      >
        <span class="mr-2">{nextText}</span>
        <Icon name="tabler:chevron-right" class="w-6 h-6" aria-hidden="true" />
      </Button>
    </div>
  </nav>
)}
