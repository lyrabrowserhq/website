---
import { APP_BLOG } from 'astrowind:config';
import { getRelatedPosts } from '~/utils/blog';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const relatedPosts = post.tags ? await getRelatedPosts(post, 4) : [];
---

{APP_BLOG.isRelatedPostsEnabled && relatedPosts.length > 0 ? (
  <section class="mx-auto max-w-3xl px-4 pb-16 md:px-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Related news</h2>
    <ul class="mt-3 space-y-2 text-sm">
      {relatedPosts.map((item) => (
        <li>
          <a
            class="text-heading underline decoration-[color:var(--aw-color-hairline)] underline-offset-4 hover:decoration-current"
            href={getPermalink(item.permalink, 'post')}
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm">
      <a class="text-muted hover:text-heading" href={getBlogPermalink()}>
        All news
      </a>
    </p>
  </section>
) : null}
