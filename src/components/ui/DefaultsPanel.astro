---
import { Icon } from 'astro-icon/components';
import Switch from '~/components/ui/Switch.astro';

interface Row {
  icon: string;
  title: string;
  hint: string;
  on: boolean;
}

const rows: Row[] = [
  {
    icon: 'tabler:search',
    title: 'Seek',
    hint: 'Default engine.',
    on: true,
  },
  {
    icon: 'tabler:ad-2',
    title: 'Block ads and trackers',
    hint: 'uBlock Origin is already in.',
    on: true,
  },
  {
    icon: 'tabler:map-pin-off',
    title: 'Share your location',
    hint: 'Off. Optional Reykjavik spoof in Settings.',
    on: false,
  },
  {
    icon: 'tabler:network',
    title: 'Let sites scan your LAN',
    hint: 'Off. Public pages cannot poke home devices.',
    on: false,
  },
  {
    icon: 'tabler:cube',
    title: 'Keep maps and video working',
    hint: 'WebGL on. WebGPU off until you allow a site.',
    on: true,
  },
];
---

<figure class="lyra-panel m-0 w-full">
  <figcaption class="lyra-panel-bar">
    <span class="text-sm font-medium text-heading">Shipped defaults</span>
  </figcaption>
  <ul class="m-0 list-none p-0">
    {rows.map((row) => (
      <li class="lyra-panel-row">
        <Icon name={row.icon} class="mt-0.5 h-4 w-4 shrink-0 text-muted" aria-hidden="true" />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium leading-snug text-heading">{row.title}</p>
          <p class="mt-0.5 text-xs leading-snug text-muted">{row.hint}</p>
        </div>
        <span class="flex shrink-0 items-center gap-2">
          <span class="sr-only">{row.on ? 'On' : 'Off'}</span>
          <span class="hidden w-7 text-right font-mono text-xs text-muted sm:inline" aria-hidden="true">
            {row.on ? 'On' : 'Off'}
          </span>
          <Switch on={row.on} label={`${row.title}: ${row.on ? 'on' : 'off'}`} />
        </span>
      </li>
    ))}
  </ul>
</figure>
