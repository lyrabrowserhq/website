---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Contact',
  description: 'Write to contact@lyrabrowser.com.',
};
---

<Layout metadata={metadata}>
  <section class="border-b border-[color:var(--aw-color-hairline)] px-4 py-12 sm:px-6 sm:py-16 md:py-20 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <Breadcrumbs class="mb-5" items={[{ text: 'Home', href: getPermalink('/') }, { text: 'Contact' }]} />
      <h1 class="max-w-2xl text-3xl font-semibold tracking-tight text-heading sm:text-4xl md:text-5xl">Contact</h1>
      <p class="mt-5 max-w-xl text-base text-default sm:text-lg">One address. No form, no ticket queue.</p>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <article class="max-w-xl rounded-lg border border-[color:var(--aw-color-hairline)] bg-[color:var(--aw-color-surface)] p-6 sm:p-8">
        <Icon name="tabler:mail" class="h-6 w-6 text-heading" aria-hidden="true" />
        <h2 class="mt-5 text-xl font-semibold tracking-tight text-heading">Email</h2>
        <p class="mt-3 text-default">
          <a
            class="font-medium text-heading underline decoration-[color:var(--aw-color-strong)] underline-offset-4"
            href="mailto:contact@lyrabrowser.com"
          >
            contact@lyrabrowser.com
          </a>
        </p>
        <p class="mt-3 text-sm text-muted">Bug reports can also go to GitHub issues.</p>
      </article>
      <p class="mt-10 text-sm text-muted">
        Source:{' '}
        <a
          class="underline decoration-[color:var(--aw-color-strong)] underline-offset-4 hover:text-heading"
          href="https://github.com/lyrabrowserhq/lyra"
        >
          github.com/lyrabrowserhq/lyra
        </a>
      </p>
    </div>
  </section>
</Layout>
